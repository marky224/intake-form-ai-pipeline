# intake-form-ai-pipeline — example environment file.
#
# Copy to `.env` and edit. `.env` is gitignored. The full set of variables
# fills out as the cascade orchestrator (Phase 5), eval harness (Phase 6),
# and review UI (Phase 7) land. The values below are the ones referenced in
# Phase 1 / Phase 4 code paths plus a handful of forward-looking flags.

# ---------------------------------------------------------------------------
# Cascade routing
# ---------------------------------------------------------------------------

# HIPAA_MODE is a deployment-posture assertion (NOT a provider-routing
# switch). The entire provider surface is BAA-eligible by design — local
# Tier 1 + Tier 3a + AWS Bedrock + AWS Textract — so the flag's runtime
# job is a defense-in-depth startup check that no non-BAA provider has
# been configured, plus raised audit-log verbosity for compliance. The
# operator is responsible for the deployment-environment side (HIPAA-
# compliant on-prem infra). See docs/hipaa-architecture.md for the full
# BAA boundary. Default: off. Synthea-generated data is not real PHI, so
# default mode is safe for development.
HIPAA_MODE=off

# EXTRACTION_MODE selects the per-tier provider implementation. See the
# tier-specific provider files in src/intake_pipeline/cascade/providers/
# (lands Phase 4). Hybrid architecture (locked 2026-05-12) — Tier 1 +
# Tier 3a are local always (no cloud half); cloud surface is BAA-eligible
# only (Textract Tier 2, Bedrock Sonnet Tier 3b, Bedrock Nova Lite Router
# Stage 2).
#   local    — full cascade against local Tier 1 + Tier 3a + BAA cloud
#              tiers (default and the normal operating mode).
#   degraded — operational failover when the local Tier 1 + Tier 3a bridge
#              is unreachable: skip local tiers, escalate every document
#              to Tier 2 Textract → Tier 3b Bedrock Sonnet. Higher per-doc
#              cost; the demo's wake page surfaces the degraded state.
EXTRACTION_MODE=local

# ---------------------------------------------------------------------------
# Eval harness (lands Phase 6)
# ---------------------------------------------------------------------------

# EVAL_LIVE=true enables paid live-provider calls in the eval harness.
# Default false; CI workflows must NEVER set this to true. Cached fixtures
# are the default replay path. See docs/eval-methodology.md.
EVAL_LIVE=false

# ---------------------------------------------------------------------------
# AWS (lands Phase 2 with the Terraform stack)
# ---------------------------------------------------------------------------

# AWS_REGION used by the cascade orchestrator and Terraform stack.
AWS_REGION=us-east-1

# AWS credentials are sourced from the standard AWS CLI profile chain
# (~/.aws/credentials, IAM role on EC2/Lambda, OIDC token in GitHub
# Actions). Do not put long-lived AWS keys in this file.

# ---------------------------------------------------------------------------
# Local model serving (Phase 1 prep — see docs/local-development.md)
# ---------------------------------------------------------------------------

# OLLAMA_KEEP_ALIVE controls how long Ollama keeps a model resident after
# its last use. Cascade orchestrator overrides this per request via
# keep_alive: "1h" during eval batches.
OLLAMA_KEEP_ALIVE=10m
