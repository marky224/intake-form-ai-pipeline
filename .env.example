# intake-form-ai-pipeline — example environment file.
#
# Copy to `.env` and edit. `.env` is gitignored. The full set of variables
# fills out as the cascade orchestrator (Phase 5), eval harness (Phase 6),
# and review UI (Phase 7) land. The values below are the ones referenced in
# Phase 1 / Phase 4 code paths plus a handful of forward-looking flags.

# ---------------------------------------------------------------------------
# Cascade routing
# ---------------------------------------------------------------------------

# HIPAA_MODE is a no-op in V1 (synthetic data only, no PHI, no cloud
# routing surface to assert against). Retained in env shape for V2
# forward-compat. In V2 the flag becomes a deployment-posture assertion
# (NOT a provider-routing switch): all V2 providers are BAA-eligible by
# design, so the flag's runtime job is a defense-in-depth startup check
# that no non-BAA provider has been configured, plus raised audit-log
# verbosity for compliance. See docs/hipaa-architecture.md for the full
# V2 BAA boundary. Default: off.
HIPAA_MODE=off

# EXTRACTION_MODE selects the per-tier provider implementation.
#
# V1 (local-first, locked 2026-05-14): only `local` is meaningful. Full
# cascade against local Tier 1 (PaddleOCR-VL) + Tier 2 (Qwen 2.5 VL 7B
# local) + Tier 3 (Qwen 2.5 VL 32B local). No cloud surface; no degraded
# failover path. The build machine runs everything in-process.
#
# V2 (deferred): adds BAA cloud tiers and a Lambda + Cloudflare Tunnel
# bridge to the home GPU. `degraded` mode triggers when the bridge is
# unreachable from Lambda: skip all local tiers, escalate every document
# through Tier 2-cloud Textract → Tier 3b Bedrock Sonnet. Higher per-doc
# cost; the demo's wake page surfaces the degraded state.
EXTRACTION_MODE=local

# ---------------------------------------------------------------------------
# Eval harness (lands Phase 6)
# ---------------------------------------------------------------------------

# EVAL_LIVE=true enables paid live-provider calls in the eval harness.
# Default false; CI workflows must NEVER set this to true. Cached fixtures
# are the default replay path. See docs/eval-methodology.md.
EVAL_LIVE=false

# ---------------------------------------------------------------------------
# AWS (lands Phase 2 with the Terraform stack)
# ---------------------------------------------------------------------------

# AWS_REGION used by the cascade orchestrator and Terraform stack.
AWS_REGION=us-east-1

# AWS credentials are sourced from the standard AWS CLI profile chain
# (~/.aws/credentials, IAM role on EC2/Lambda, OIDC token in GitHub
# Actions). Do not put long-lived AWS keys in this file.

# ---------------------------------------------------------------------------
# Local model serving (Phase 1 prep — see docs/local-development.md)
# ---------------------------------------------------------------------------

# OLLAMA_KEEP_ALIVE controls how long Ollama keeps a model resident after
# its last use. Cascade orchestrator overrides this per request via
# keep_alive: "1h" during eval batches.
OLLAMA_KEEP_ALIVE=10m
